# ====================== GENERAL ======================
:ubuntu-22.04-default
kernel ${base_url}/ubuntu-squash/releases/download/22.04.3-7854d2c9/vmlinuz
initrd ${base_url}/ubuntu-squash/releases/download/22.04.3-7854d2c9/initrd
imgargs vmlinuz boot=live nomodeset
