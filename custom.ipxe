#!ipxe

# =============================================
# 4NDR0666OS WEAPONIZED ENGAGEMENT MENU v7.2
# Base: https://github.com/4ndr0666/netboot.xyz-custom
# INFORMATION IS INERT. Maximum freedom.
# =============================================

set base_url https://github.com/4ndr0666/netboot.xyz-custom/raw/refs/heads/master

:boot_fail
echo Boot failed. Returning to menu...
sleep 3
goto main_menu

:main_menu
menu 4NDR0666OS — Engagement Live Menu [v7.2]
item --gap --                   === OFFENSIVE / PENTEST ===
item kali                      Kali Linux XFCE
item parrot-security           Parrot Security
item blackarch                 BlackArch
item garuda-dr460nized         Garuda Dr460nized (Gaming)
item garuda-gaming             Garuda Gaming
item --gap --                   === PRIVACY / OPSEC ===
item tails                     Tails
item kodachi-8                 Kodachi 8
item --gap --                   === FORENSICS & RECOVERY ===
item systemrescue-amd64        SystemRescue Latest
item caine                     CAINE
item rescatux                  Rescatux
item bootrepair                Boot-Repair
item --gap --                   === DISK / CLONE / WIPE ===
item gparted                   GParted
item clonezilla-ubuntu         Clonezilla
item dban                      DBAN
item shredos                   ShredOS
item --gap --                   === GENERAL LIVE ===
item ubuntu-22.04-default      Ubuntu 22.04 GNOME
item debian-12-gnome           Debian 12 GNOME
item mint-21-cinnamon          Mint 21 Cinnamon
item 4mlinux-full              4MLinux Full
item 4mlinux-antivirus         4MLinux Antivirus
item --gap --                   === ADDITIONAL ===
item memtest86                 MemTest86+
item breakin                   Breakin Stress
item netbootxyz                Official netboot.xyz
item exit                      Exit to BIOS
choose --default systemrescue-amd64 --timeout 7000 option || goto boot_fail
goto ${option}

# ====================== OFFENSIVE ======================
:kali
kernel ${base_url}/debian-squash/releases/download/2023.3-e15f31ba/vmlinuz
initrd ${base_url}/debian-squash/releases/download/2023.3-e15f31ba/initrd
imgargs vmlinuz boot=live nomodeset
boot || goto boot_fail

:parrot-security
kernel ${base_url}/debian-squash/releases/download/5.1.1-47327415/vmlinuz
initrd ${base_url}/debian-squash/releases/download/5.1.1-47327415/initrd
